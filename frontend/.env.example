# ---------------------------------------------------------------------------
# CLEAN-AM frontend configuration
#
# Fill these in from the backend's `cdk deploy` outputs.
# ---------------------------------------------------------------------------

# CleanAm-Dev-Api output "ApiUrl", e.g. https://abc123.execute-api.eu-west-1.amazonaws.com/dev/
CLEAN_AM_API_URL=

# CleanAm-Dev-Data outputs
COGNITO_REGION=eu-west-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# The app client's secret. It never reaches the browser: every Cognito call is
# made from the Next.js server.
#
# In AWS (Amplify Hosting): set the ARN from the CleanAm-Dev-Data output
# "WebClientSecretArn". The server reads the secret from Secrets Manager at
# runtime, so the secret itself is never configuration (SRS NFR-SEC-02). The
# Amplify app's compute role needs secretsmanager:GetSecretValue on that ARN.
COGNITO_CLIENT_SECRET_ARN=

# CleanAm-Dev-Data output "CognitoDomain", e.g.
# https://clean-am-dev-123456.auth.eu-west-1.amazoncognito.com
COGNITO_DOMAIN=

# "true" shows "Continue with Google" (needs COGNITO_DOMAIN and the backend
# deployed with -c googleClientId=... -c googleSecretArn=...).
GOOGLE_SIGN_IN=false

# The site's public address, if the server cannot tell it from the request
# (behind some proxies). Used for Google's return address. Usually leave empty.
CLEAN_AM_SITE_URL=

# Only for a machine with no AWS login: the secret itself, from the Cognito
# console (App clients > the web client). Keep it in .env.local, never commit
# it. Ignored whenever COGNITO_CLIENT_SECRET_ARN is set.
COGNITO_CLIENT_SECRET=
